# --- Browser / session ---
# HEADLESS=false is required in production: real headful Chrome (under xvfb-run
# on the VPS) is what keeps Cloudflare happy.
HEADLESS=false
FORG1_URL=https://www.forg1.com/predicciones
STORAGE_STATE_PATH=.auth/forg1_state.json
CHROME_PROFILE_DIR=.auth/chrome-profile

# --- Polling (smart wait, no aggressive polling) ---
POLL_INTERVAL_IDLE_SECONDS=45
POLL_INTERVAL_ACTIVE_SECONDS=5
PAGE_REFRESH_AFTER_IDLE_SECONDS=1200
PREDICTION_STABILIZATION_SECONDS=50
# Header balance-refresh click; only fires while the Kick stream is live. 0 = off.
BALANCE_REFRESH_INTERVAL_SECONDS=120

# --- Strategy ---
# Forg1 es pari-mutuel: la parte del pool que tiene una opción ES su precio.
# Una opción con el 90% del pool paga 0.11x, así que apostarle necesita ganar
# 90% de las veces sólo para empatar. Por eso el bot NO le apuesta al favorito.
#
# Cuánto creerle a la multitud. 1.0 = está perfectamente calibrada (=> no existe
# ninguna ventaja y el bot casi no apuesta). Medido sobre 86 head-to-heads de
# este mismo bot (2026-08-31): la multitud implicaba 67.8% para el favorito y
# ganó 65.1% => 0.85. El 0.12 anterior salía de n=19 y no sobrevivió a la
# muestra grande. Recalculalo con: uv run python scripts/analyze_results.py
STRATEGY_CROWD_WEIGHT=0.85
# Sin ranking oficial (kills, apellidos, preguntas sueltas) la multitud es lo
# único que hay. Cualquier valor <1.0 favorece al underdog: eso es la forma del
# pool pari-mutuel, el número solo fija qué tan buen precio exige. Se mide sobre
# mapas de CS2 solamente, así que aplicarlo acá es un supuesto, no una medición.
STRATEGY_UNRATED_CROWD_WEIGHT=0.85
# Fracción del Kelly completo. 0.5 da ~75% del crecimiento con la mitad del swing.
# 1.0 es peor que 0.5 incluso si el modelo tiene razón: con el techo del 25%,
# Kelly completo ya pasa el punto óptimo de crecimiento. No lo subas.
STRATEGY_KELLY_FRACTION=0.5
# Techo duro por apuesta, % del balance. Red de seguridad, no perilla de tuneo.
STRATEGY_MAX_PCT=25
# Ventaja mínima esperada por unidad apostada para que valga la pena entrar.
STRATEGY_MIN_EDGE=0.05
# Peso del ranking oficial de Valve vs el precio del pool (sólo 1v1 con ambos
# equipos rankeados). 0 lo desactiva. Refrescar con:
#   uv run python scripts/fetch_team_ratings.py
STRATEGY_RATING_WEIGHT=0.35
STRATEGY_RATING_SCALE=1400
# Sólo mercados de hasta N opciones. Las 4 apuestas multi-opción del log perdieron.
STRATEGY_MAX_OUTCOMES=2
# Excepción: los mercados de mapa Equipo/Equipo/OT sí se juegan. "OT" gana el
# mercado entero (las apuestas a los equipos pierden), así que se cotiza aparte
# con este peso. En 1.0 vale exactamente lo que paga el pool = edge cero: nunca
# se apuesta al OT, sólo a los dos equipos. Bajarlo lo vuelve apostable.
STRATEGY_OT_CROWD_WEIGHT=1.0
# Orden fija: apostar SIEMPRE a estos equipos cuando juegan, al precio que sea
# (separados por coma). Se saltea el control de edge: bancar al favorito con el
# 85% del pool paga 0.18x y necesita que gane el 85% de las veces para empatar.
# El monto es el de Kelly si el precio es bueno, y min_bet si no lo es.
# Vacío por defecto: sin órdenes fijas, todo pasa por el control de edge.
STRATEGY_ALWAYS_BACK=
# Respaldo al favorito: cuando la estrategia no apuesta (sin edge, filtro de
# forma, mercado de 3+ opciones), apostar al que más pool tiene con esta
# fracción del balance (tope: max_bet del sitio). Empate arriba = no apuesta.
# 0 lo desactiva.
STRATEGY_FAV_FALLBACK_PCT=0.25
TEAM_RATINGS_PATH=.data/team_ratings.json

# --- MapForm: fuerza por equipo (y por mapa) sacada de resultados reales ------
# Segunda opinión externa, armada con Elo sobre ~55.000 mapas de bo3.gg. Conoce
# miles de equipos que Valve no rankea nunca. Refrescar con:
#   uv run python scripts/fetch_match_history.py     (incremental, unos segundos)
#   uv run python scripts/fit_map_form.py            (re-ajusta las constantes)
#
# ARRANCA EN 0 (APAGADO) A PROPOSITO. Tener mejores datos no es lo mismo que
# tenerle ventaja al pool: el ranking de Valve le gana a una moneda y aun asi NO
# le gana al pool. Prendelo solo cuando scripts/analyze_results.py imprima un
# intervalo de confianza de "MapForm vs the pool" que no cruce el cero.
# 2026-10-07: si existe .data/counterpredictor.json (scripts/export_counterpredictor.py)
# este peso lo usa CounterPredictor en lugar de MapForm. 0.2 por replay (ver CLAUDE.md).
STRATEGY_FORM_WEIGHT=0.2
# Constantes AJUSTADAS sobre 10.716 mapas fuera de muestra (log loss 0.6619 vs
# 0.6931 de una moneda, 59,7% de acierto). No las inventes a ojo: corré
# scripts/fit_map_form.py, que las mide y avisa si el óptimo se le escapa.
STRATEGY_FORM_SCALE=400
STRATEGY_FORM_K_GLOBAL=52
STRATEGY_FORM_K_MAP=16
# Equipos con menos mapas que esto no reciben número: un Elo de tres partidos es
# ruido con formato de estadística.
STRATEGY_FORM_MIN_GAMES=10
MATCH_HISTORY_PATH=.data/match_history.json
# Preguntarle a bo3.gg en qué mapa se juega un mercado de "2do MAPA". Un request
# HTTP por mercado nuevo; si falla, se apuesta igual pero sin dato de mapa.
RESOLVE_MAP_NAMES=true

# --- Freno automático ---
# Deja de apostar si el balance cae este % respecto del arranque de la sesión.
# Avisa por Telegram y sigue monitoreando. Reiniciar el bot lo rehabilita.
BANKROLL_STOP_PCT=40

# --- Telegram ---
# Token: crear bot con @BotFather en Telegram.
# CHAT_ID: dejalo vacío, mandale un mensaje al bot y el bot lo detecta al arrancar
# (queda en el log; pegalo acá para los próximos arranques).
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=
# api.telegram.org tarda 10-16s desde algunas redes y a veces se cuelga. 10s era
# muy poco y los mensajes fallaban al azar ("handshake operation timed out").
# Un intento colgado no se recupera, pero una conexión nueva anda en ~1s: por eso
# el reintento es lo que salva el mensaje, no esperar más.
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_ATTEMPTS=3

# --- Kick live-check (alert only, no auto-refresh/keep-alive) ---
KICK_CHANNEL=forg1
KICK_CHECK_INTERVAL_SECONDS=1800

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- State ---
SEEN_PREDICTIONS_PATH=.data/seen_predictions.json
# Cada mercado resuelto (shares finales + ganador + nuestra apuesta) se agrega
# acá. Es la data con la que analyze_results.py recalcula STRATEGY_CROWD_WEIGHT.
RESULTS_LOG_PATH=.data/results.jsonl
