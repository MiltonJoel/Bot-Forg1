# --- Browser / session ---
HEADLESS=false
FORG1_URL=https://www.forg1.com/predicciones
STORAGE_STATE_PATH=.auth/forg1_state.json

# --- Polling (smart wait, no aggressive polling) ---
POLL_INTERVAL_IDLE_SECONDS=45
POLL_INTERVAL_ACTIVE_SECONDS=5
PAGE_REFRESH_AFTER_IDLE_SECONDS=1200

# --- Strategy ---
HIGH_PROBABILITY_THRESHOLD=90
BET_HIGH_PERCENTAGE=35
BET_LOW_PERCENTAGE=20

# --- Telegram ---
# Token: crear bot con @BotFather en Telegram.
# CHAT_ID: dejalo vacío, mandale un mensaje al bot y el bot lo detecta al arrancar
# (queda en el log; pegalo acá para los próximos arranques).
TELEGRAM_BOT_TOKEN=L47J4VZC
TELEGRAM_CHAT_ID=

# --- Kick live-check (alert only, no auto-refresh/keep-alive) ---
KICK_CHANNEL=forg1
KICK_CHECK_INTERVAL_SECONDS=1800

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- State ---
SEEN_PREDICTIONS_PATH=.data/seen_predictions.json
