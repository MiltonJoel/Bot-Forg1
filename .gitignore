# --- Secrets & runtime state (never commit) ---
# real secrets; .env.example IS tracked (backups like .env.bak-* covered too)
.env
.env.*
!.env.example
# Chrome profile + session cookies (~1.7G, sensitive)
.auth/
# seen-predictions state, etc.
.data/
logs/
*.log

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Local agent/editor dirs ---
.claude/
.codex/
.agents/
.idea/
.vscode/
.DS_Store

# stray Chrome profile created by an unexpanded "~" path
/~/
